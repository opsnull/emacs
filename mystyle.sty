% Org 在样式包之后声明 Code；这里只调整代码框，保留主题的高亮宏。
\makeatletter
\AtBeginDocument{%
  \@ifundefined{Code}{}{%
    % 默认在空格和标点处折行，但是对于 URL 和路径，可能不满足该要求，导致不会被折行而显示溢出。
    % 解决办法：设置在空格、/ 和 - 字符处折行。
    \fvset{breaklines=true,breakanywhere=false,breakafter={/-},breaknonspaceingroup=true}%
    \RenewTColorBox{Code}{o}{%
      colback=EfD,colframe=EfD!80!EFD,colupper=EFD,
      fontupper=\fontsize{9.5}{12}\selectfont\setlength{\fboxsep}{0pt},
      boxsep=2pt,arc=2pt,boxrule=0.4pt,left=4pt,right=4pt,top=3pt,bottom=3pt,
      before skip=0.6em,after skip=0.6em,breakable,lines before break=5,
      title after break={代码（续）},fonttitle=\normalfont\small,
      coltitle=EFD,colbacktitle=EfD!90!EFD,
      IfNoValueTF={#1}{}{boxrule=0pt,leftrule=1pt}}
  }%
}
\makeatother

% 从 mystle.sty 所在目录加载自定义的 org-pdf-copy package。
% org-pdf-copy 提供代码块复制能力：
% 1. 不复制行号；
% 2. 保留代码的缩进和换行;
% 3. 支持长行复制(视觉显示换行,但是拷贝后是物理单行);
% 文档可在加载样式前用 \newcommand{\OrgPDFCopyDisabled}{} 关闭复制特性。
\makeatletter
\@ifundefined{OrgPDFCopyDisabled}{\RequirePackage{\@currpath org-pdf-copy}}{}
\makeatother
