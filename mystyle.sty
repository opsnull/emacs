% 技术讲义样式。支持中英文混排、emoji 字符、代码块原样复制和长行复制。
\usepackage{iftex}
\RequireLuaTeX
\usepackage{xcolor}
\definecolor{winered}{rgb}{0.5,0,0}
\definecolor{lightgrey}{gray}{0.96}
\definecolor{tableheadcolor}{gray}{0.92}
\definecolor{commentcolor}{RGB}{0,100,0}
\definecolor{frenchplum}{RGB}{190,20,83}
\definecolor{documentlink}{HTML}{245A81}

\usepackage{fontspec}
% 定义 emoji fallback 字体指令：appleemoji
\directlua{
  luaotfload.add_fallback("appleemoji", {
    "Apple Color Emoji:mode=harf;script=DFLT;"
  })
}

% 设置英文字体
% Noto CJK 字体没有原生西文斜体：明确使用合成倾斜，避免隐式字形替代。
% Noto CJK 也没有 emoji 字体，需要 fallback 到 appleemoji。
\setmainfont{Noto Serif CJK SC}[
  ItalicFont=*, ItalicFeatures={FakeSlant=0.15},
  SlantedFont=*, SlantedFeatures={FakeSlant=0.15},
  BoldItalicFont=* Bold, BoldItalicFeatures={FakeSlant=0.15},
  BoldSlantedFont=* Bold, BoldSlantedFeatures={FakeSlant=0.15},
  RawFeature={fallback=appleemoji}
]
\setsansfont{Noto Sans CJK SC}[
  Scale=MatchLowercase,
  ItalicFont=*, ItalicFeatures={FakeSlant=0.15},
  SlantedFont=*, SlantedFeatures={FakeSlant=0.15},
  BoldItalicFont=* Bold, BoldItalicFeatures={FakeSlant=0.15},
  BoldSlantedFont=* Bold, BoldSlantedFeatures={FakeSlant=0.15},
  RawFeature={fallback=appleemoji}
]
% 英文 mono（如格式化代码块场景）使用苹果的 Menlo 字体。
\setmonofont{Menlo}[Scale=MatchLowercase,RawFeature={fallback=appleemoji}]

% 设置中文字体。
% 中文强调使用粗体，不伪造中文斜体。
\setCJKmainfont{Noto Serif CJK SC}[ItalicFont=* Bold,SlantedFont=* Bold]
\setCJKsansfont{Noto Sans CJK SC}[ItalicFont=* Bold,SlantedFont=* Bold]
\setCJKmonofont{Noto Sans Mono CJK SC}[Scale=0.9,ItalicFont=*,SlantedFont=*]
\ltjdefcharrange{100}{"2600-"27BF,"1F000-"1FAFF,"FE0E-"FE0F,"200D}
\ltjsetparameter{jacharrange={-100}}

\usepackage[left=18mm,right=18mm,top=22mm,bottom=22mm,headheight=15pt]{geometry}
\usepackage{parskip}
\setlength{\parskip}{0.5em plus 0.1em minus 0.1em}
\setlength{\parindent}{0pt}
\linespread{1.1}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\setlength{\emergencystretch}{1.5em}
\usepackage{etoolbox}
\usepackage{needspace}
% 普通节连续排版；需要另起页的大篇章在正文显式调用 \DocumentPartBreak。
\newcommand{\DocumentPartBreak}{\clearpage}
\newcommand{\DocumentContents}{\begingroup\setlength{\parskip}{0pt}\linespread{1}\selectfont\tableofcontents\endgroup}
\ctexset{
  section={format=\normalfont\Large\bfseries,beforeskip=1.2ex plus .3ex,afterskip=.8ex},
  subsection={format=\normalfont\large\bfseries,beforeskip=1ex plus .2ex,afterskip=.6ex},
  subsubsection={format=\normalfont\normalsize\bfseries,beforeskip=.8ex,afterskip=.4ex}
}
\AddToHook{cmd/section/before}{\Needspace{5\baselineskip}}
\AddToHook{cmd/subsection/before}{\Needspace{4\baselineskip}}
\AddToHook{cmd/subsubsection/before}{\Needspace{4\baselineskip}}

\usepackage{hyperref}
\usepackage{xurl}
\hypersetup{pdfborder={0 0 0},colorlinks=true,
  bookmarksopen=false,bookmarksnumbered=true,
  linkcolor=black,urlcolor=documentlink,filecolor=documentlink,
  citecolor=documentlink,linktoc=all}
\urlstyle{same}
\newcommand\email[1]{\href{mailto:#1}{\nolinkurl{#1}}}
\usepackage{graphicx}
\usepackage{wallpaper} % 兼容已有文档的封面命令。
\graphicspath{{image/}{figure/}{fig/}{img/}{images/}}
\usepackage{titling}
\makeatletter
% title:nil 仅抑制 Org 自动封面，不应清空 PDF 的标题元数据。
% Org 把副标题格式合入 \@title；元数据中将其转为空格，避免 hyperref 警告。
\pdfstringdefDisableCommands{\def\\{ }\def\medskip{}\def\large{}}
\AtBeginDocument{\hypersetup{pdftitle={\@title},pdfauthor={\@author},
  pdfcreator={Org mode / LuaLaTeX}}}
\newcommand{\MakeDocumentCover}[1]{%
  \begin{titlepage}\thispagestyle{empty}\centering
  \vspace*{0.10\textheight}
  {\fontsize{24}{34}\selectfont\bfseries\@title\par}
  \vspace{1.5em}
  {\normalsize\@author\par\vspace{0.5em}\@date\par}
  \ifstrempty{#1}{}{\vspace{3em}%
    \includegraphics[width=0.72\linewidth,height=0.35\textheight,keepaspectratio]{#1}\par}
  \vfill
  \end{titlepage}}
\makeatother

